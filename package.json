{
  "name": "@orthic-labs/cortex",
  "version": "0.2.0",
  "description": "Local evidence-backed repository map: documents, claims, code graph, and orientation admission library.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "blueprint": "./scripts/blueprint.mjs",
    "cortex": "./scripts/blueprint.mjs",
    "cortex-watch": "./scripts/cortex-watch.mjs"
  },
  "files": [
    "scripts/",
    "watchman/",
    "graph/",
    "lib/",
    "sources/",
    "schemas/",
    "evals/fixture-repos/",
    "references/",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "package.json"
  ],
  "exports": {
    ".": "./lib/admission.mjs",
    "./admission": "./lib/admission.mjs",
    "./receipt-store": "./lib/receipt-store.mjs",
    "./orientation-evidence": "./lib/orientation-evidence.mjs"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "test:workspace": "node --test \"tests/workspace/**/*.test.mjs\"",
    "test:all": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@parcel/watcher": "2.6.0",
    "hash-wasm": "4.12.0",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.26.11"
  }
}
