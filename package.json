{
  "name": "@orthic-labs/cortex",
  "version": "0.2.0",
  "description": "Cortex: local evidence-backed repository map — documents, claims, code graph (Neurons/Synapses/Circuits), and orientation admission library.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "cortex": "./scripts/cortex.mjs",
    "cortex-watch": "./scripts/cortex-watch.mjs",
    "cortex-mcp": "./scripts/cortex-mcp.mjs",
    "cortex-install": "./scripts/cortex-install.mjs"
  },
  "files": [
    "scripts/",
    "watchman/",
    "graph/",
    "lib/",
    "sources/",
    "schemas/",
    "evals/fixture-repos/",
    "references/",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "package.json"
  ],
  "exports": {
    ".": "./lib/admission.mjs",
    "./admission": "./lib/admission.mjs",
    "./receipt-store": "./lib/receipt-store.mjs",
    "./orientation-evidence": "./lib/orientation-evidence.mjs"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "test:workspace": "node --test \"tests/workspace/**/*.test.mjs\"",
    "test:all": "node --test --test-concurrency=1 \"tests/**/*.test.mjs\"",
    "test:random": "node scripts/test-random.mjs",
    "bench:retrieval": "node scripts/benchmark-retrieval.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@parcel/watcher": "2.6.0",
    "hash-wasm": "4.12.0",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.26.11",
    "zod": "4.4.3"
  }
}
