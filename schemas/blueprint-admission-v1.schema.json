{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orthic.labs/schemas/blueprint-admission-v1.json",
  "title": "BlueprintAdmissionDecisionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "action",
    "reason",
    "reasonCode",
    "receiptId",
    "allowedScopes",
    "omissions",
    "nextAction"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "action": { "enum": ["allow", "continue", "block", "noop"] },
    "reason": { "type": "string" },
    "reasonCode": { "type": ["string", "null"] },
    "receiptId": { "type": ["string", "null"] },
    "candidateSet": { "type": ["object", "null"] },
    "allowedScopes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "omissions": {
      "type": "array",
      "items": { "type": "object" }
    },
    "nextAction": { "type": ["string", "null"] },
    "evidence": { "type": ["object", "null"] },
    "evidencePath": { "type": ["string", "null"] },
    "receipt": { "type": ["object", "null"] }
  }
}
